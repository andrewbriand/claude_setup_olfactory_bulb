+def _tube_path(p):
+    '''Voxels along the segment -> bulb-surface line, in order, without repeats.
+
+    The candidate set is the union of the offset cube centred on each of these.
+    '''
+    p_up = _BND_UP.project(p)
+    p_dw = _BND_DW.project(p)
+    d = params.gran_voxel
+    ux = p_up[0] - p_dw[0]
+    uy = p_up[1] - p_dw[1]
+    uz = p_up[2] - p_dw[2]
+    nmoves = 1 + int(misc.distance(p_up, p_dw) / params.gran_voxel)
+    step = 1.0 / nmoves
+    path = []
+    seen = set()
+    x = 0.0
+    while x < 1:
+        q = (int((p_dw[0]+x*ux)/d)*d,
+             int((p_dw[1]+x*uy)/d)*d,
+             int((p_dw[2]+x*uz)/d)*d)
+        if q not in seen:
+            seen.add(q)
+            path.append(q)
+        x += step
+    return path
+
+
 ''' get the voxels below the segment would connect to '''

 import misc
 granules = params.granules
 from gidfunc import *
+import os
+from functools import lru_cache
+from itertools import compress
+
+# Speed-ups for the mitral->granule candidate search, which dominates model setup.
+# All of these keep the sequence of points inserted into `pts` below byte-identical,
+# so the RNG stream in connect_to_granule (and hence the network) is unchanged.
+# Entries in the per-voxel neighbour cache; ~19 KB each (125 tuples + overhead).
+# Setup time keeps improving up to ~131072 (the working set), then flattens; lower it
+# on memory-constrained machines, 0 disables caching. See README "Setup and teardown performance".
+_NEIGHBOUR_CACHE = int(os.environ.get('OB_NEIGHBOUR_CACHE', '65536'))
+
+_OFFSETS = ()   # snapshot of _gran_voxel in its (stable) iteration order; set in init()
+_OFFSET_SET = frozenset()
+_MASKS = {}     # step -> which offsets are new w.r.t. the previous voxel's cube
+_BND_UP = None  # the two boundary ellipsoids, built once instead of per call
+_BND_DW = None
+
+
+@lru_cache(maxsize=_NEIGHBOUR_CACHE)
+def _voxel_neighbours(q):
+    '''Candidate points around one voxel. 89% of lookups repeat, so cache them.'''
+    qx, qy, qz = q
+    return [(qx + dx, qy + dy, qz + dz) for dx, dy, dz in _OFFSETS]
+
+
+def _new_mask(step):
+    '''Offsets whose point is NOT already in the previous voxel's cube.
+
+    Walking the path, voxel q's cube overlaps its predecessor's heavily (3.3x
+    redundancy overall). Everything in the overlap was inserted at the previous
+    step, so inserting only the rest gives the same set -- and, because the mask
+    keeps _OFFSETS order, the same first-insertion order, hence the same
+    list(set) order and the same RNG mapping.
+    '''
+    m = _MASKS.get(step)
+    if m is None:
+        sx, sy, sz = step
+        m = tuple((ox + sx, oy + sy, oz + sz) not in _OFFSET_SET
+                  for ox, oy, oz in _OFFSETS)
+        _MASKS[step] = m
+    return m
 

+_gcissup = {}
+
+def gc_is_superficial(ggid):
+  # Pure function of ggid, called ~2x per granule (~18 us each) while building
+  # synapses and granules: memoize it, and use the boundary ellipsoids built once
+  # in init() instead of constructing two per call.
+  r = _gcissup.get(ggid)
+  if r is None:
+    p = granules.ggid2pos[ggid]
+    r = _gcissup[ggid] = \
+        (_BND_DW.normalRadius(p)-1)/(_BND_DW.normalRadius(_BND_UP.project(p))-1) > 0.5
+  return r
 

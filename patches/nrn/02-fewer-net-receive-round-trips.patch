+void net_buf_receive_all(NrnThread* nt) {
+    auto const& net_buf_receive = corenrn.get_net_buf_receive();
+    auto const finish = [nt](auto const& f) {
+        std::string name("net-buf-receive-");
+        name += nrn_get_mechname(f.second);
+        Instrumentor::phase p(name.c_str());
+        (*f.first)(nt);
+    };
+    if (!nt->compute_gpu) {
+        nt->_net_buf_receive_phase = NRN_NET_BUF_RECEIVE_ALL;
+        for (auto const& f: net_buf_receive) {
+            finish(f);
+        }
+        return;
+    }
+    // Launch every mechanism's NET_RECEIVE kernel (and the copy of its send-buffer count)
+    // back to back, wait once, then move sent events to the host in the original mechanism
+    // order. The kernels run in the same order on the same stream as before, and no kernel
+    // depends on another mechanism's host-side processing, so results are unchanged.
+    nt->_net_buf_receive_phase = NRN_NET_BUF_RECEIVE_LAUNCH;
+    {
+        Instrumentor::phase p("net-buf-receive-launch");
+        for (auto const& f: net_buf_receive) {
+            (*f.first)(nt);
+        }
+    }
+    {
+        Instrumentor::phase p("net-buf-receive-wait");
+        nrn_pragma_acc(wait(nt->stream_id))
+    }
+    nt->_net_buf_receive_phase = NRN_NET_BUF_RECEIVE_FINISH;
+    for (auto const& f: net_buf_receive) {
+        finish(f);
+    }
+    nt->_net_buf_receive_phase = NRN_NET_BUF_RECEIVE_ALL;

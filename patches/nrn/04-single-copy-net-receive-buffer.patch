+// NetReceiveBuffer_t rows: the six arrays are rows of one block with a common pitch, so that
+// the used prefix of all of them reaches the GPU in one 2D copy (update_net_receive_buffer).
+namespace {
+enum : int {
+    nrb_row_t,
+    nrb_row_flag,
+    nrb_row_pnt_index,
+    nrb_row_weight_index,
+    nrb_row_displ,
+    nrb_row_nrb_index,
+    nrb_nrows
+};
+}  // namespace
+
+void nrn_net_receive_buffer_alloc(NetReceiveBuffer_t* nrb, int size) {
+    // Every row holds at most size + 1 elements of at most 8 bytes; keep rows 64-byte aligned.
+    std::size_t const pitch = ((size + 1) * sizeof(double) + 63) / 64 * 64;
+    std::size_t const bytes = nrb_nrows * pitch;
+    void* rows{};
+    int pinned{};
+#ifdef CORENEURON_ENABLE_GPU
+    if (gpu_enabled()) {
+        // Pinned, so that the per-timestep upload is a true asynchronous copy.
+        auto const code = cudaMallocHost(&rows, bytes);
+        assert(code == cudaSuccess);
+        std::memset(rows, 0, bytes);
+        pinned = 1;
+    }
+#endif
+    if (!rows) {
+        rows = ecalloc_align(bytes, 1);
+    }
+    auto* const base = static_cast<char*>(rows);
+    nrb->_rows = rows;
+    nrb->_row_pitch = pitch;
+    nrb->_rows_pinned = pinned;
+    nrb->_size = size;
+    nrb->_nrb_t = reinterpret_cast<double*>(base + nrb_row_t * pitch);
+    nrb->_nrb_flag = reinterpret_cast<double*>(base + nrb_row_flag * pitch);
+    nrb->_pnt_index = reinterpret_cast<int*>(base + nrb_row_pnt_index * pitch);
+    nrb->_weight_index = reinterpret_cast<int*>(base + nrb_row_weight_index * pitch);
+    nrb->_displ = reinterpret_cast<int*>(base + nrb_row_displ * pitch);
+    nrb->_nrb_index = reinterpret_cast<int*>(base + nrb_row_nrb_index * pitch);
+}
+
+void nrn_net_receive_buffer_free(NetReceiveBuffer_t* nrb) {
+    if (!nrb->_rows) {
+        return;
+    }
+#ifdef CORENEURON_ENABLE_GPU
+    if (nrb->_rows_pinned) {
+        auto const code = cudaFreeHost(nrb->_rows);
+        assert(code == cudaSuccess);
+    } else
+#endif
+    {
+        free_memory(nrb->_rows);
+    }
+    nrb->_rows = nullptr;
+    nrb->_nrb_t = nrb->_nrb_flag = nullptr;
+    nrb->_pnt_index = nrb->_weight_index = nrb->_displ = nrb->_nrb_index = nullptr;
+}
+
+#ifdef CORENEURON_ENABLE_GPU
+/* Map nrb's row block onto the device (same layout) and point the device struct's array
+ * members at the device rows. */
+static void net_receive_buffer_rows_to_device(NetReceiveBuffer_t* nrb, NetReceiveBuffer_t* d_nrb) {
+    char* const d_rows = cnrn_target_copyin(static_cast<char*>(nrb->_rows),
+                                            nrb_nrows * nrb->_row_pitch);
+    auto const row = [d_rows, pitch = nrb->_row_pitch](int i) { return d_rows + i * pitch; };
+    double* d_dbl = reinterpret_cast<double*>(row(nrb_row_t));
+    cnrn_target_memcpy_to_device(&(d_nrb->_nrb_t), &d_dbl);
+    d_dbl = reinterpret_cast<double*>(row(nrb_row_flag));
+    cnrn_target_memcpy_to_device(&(d_nrb->_nrb_flag), &d_dbl);
+    int* d_int = reinterpret_cast<int*>(row(nrb_row_pnt_index));
+    cnrn_target_memcpy_to_device(&(d_nrb->_pnt_index), &d_int);
+    d_int = reinterpret_cast<int*>(row(nrb_row_weight_index));
+    cnrn_target_memcpy_to_device(&(d_nrb->_weight_index), &d_int);
+    d_int = reinterpret_cast<int*>(row(nrb_row_displ));
+    cnrn_target_memcpy_to_device(&(d_nrb->_displ), &d_int);
+    d_int = reinterpret_cast<int*>(row(nrb_row_nrb_index));
+    cnrn_target_memcpy_to_device(&(d_nrb->_nrb_index), &d_int);
+}
+#endif

-    nrn_pragma_acc(wait(nt->stream_id))
+    // No wait here: net_buf_receive_all() launches the NET_RECEIVE kernels behind these copies
+    // on the same stream and then waits once, before the host touches the buffers again.
+}
+
+void net_send_buffer_count_to_host_async(NrnThread* nt, NetSendBuffer_t* nsb) {
+#ifdef CORENEURON_ENABLE_GPU
+    if (nt->compute_gpu) {
+#if !defined(CORENEURON_PREFER_OPENMP_OFFLOAD) && defined(_OPENACC)
+        NetSendBuffer_t* const d_nsb = cnrn_target_deviceptr(nsb);
+        auto const code = cudaMemcpyAsync(nsb->_cnt_host,
+                                          &(d_nsb->_cnt),
+                                          sizeof(int),
+                                          cudaMemcpyDeviceToHost,
+                                          static_cast<cudaStream_t>(
+                                              acc_get_cuda_stream(nt->stream_id)));
+        assert(code == cudaSuccess);
+#else
+        nrn_pragma_omp(target update from(nsb->_cnt))
+        *nsb->_cnt_host = nsb->_cnt;
+#endif
+    }
+#else
+    static_cast<void>(nt);
+    static_cast<void>(nsb);
+#endif
+}
+
+void net_send_buffer_count_clear(NrnThread* nt, NetSendBuffer_t* nsb) {
+    if (nt->compute_gpu && nsb->_cnt_host) {
+        *nsb->_cnt_host = 0;
+    }
+}
+
+int net_send_buffer_count_on_host(NrnThread* nt, NetSendBuffer_t* nsb) {
+    if (nt->compute_gpu && nsb->_cnt_host) {
+        return *nsb->_cnt_host;
+    }
+    return nsb->_cnt;
+}
+
+void net_buf_receive_all(NrnThread* nt) {
+    auto const& net_buf_receive = corenrn.get_net_buf_receive();
+    auto const finish = [nt](auto const& f) {
+        std::string name("net-buf-receive-");
+        name += nrn_get_mechname(f.second);
+        Instrumentor::phase p(name.c_str());
+        (*f.first)(nt);
+    };
+    if (!nt->compute_gpu) {
+        nt->_net_buf_receive_phase = NRN_NET_BUF_RECEIVE_ALL;
+        for (auto const& f: net_buf_receive) {
+            finish(f);
+        }
+        return;
+    }
+    // Launch every mechanism's NET_RECEIVE kernel (and the copy of its send-buffer count)
+    // back to back, wait once, then move sent events to the host in the original mechanism
+    // order. The kernels run in the same order on the same stream as before, and no kernel
+    // depends on another mechanism's host-side processing, so results are unchanged.
+    nt->_net_buf_receive_phase = NRN_NET_BUF_RECEIVE_LAUNCH;
+    {
+        Instrumentor::phase p("net-buf-receive-launch");
+        for (auto const& f: net_buf_receive) {
+            (*f.first)(nt);
+        }
+    }
+    {
+        Instrumentor::phase p("net-buf-receive-wait");
+        nrn_pragma_acc(wait(nt->stream_id))
+    }
+    nt->_net_buf_receive_phase = NRN_NET_BUF_RECEIVE_FINISH;
+    for (auto const& f: net_buf_receive) {
+        finish(f);
+    }
+    nt->_net_buf_receive_phase = NRN_NET_BUF_RECEIVE_ALL;
 }
 
